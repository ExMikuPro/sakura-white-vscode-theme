  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#515D69",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "storage.type.string.python"
      ],
      "settings": {
        "foreground": "#276349",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#7D4B21",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A62562",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6941A1",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#245B91",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable.local.cs",
        "entity.name.variable.parameter.cs"
      ],
      "settings": {
        "foreground": "#414A5A",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#625068",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags and components",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#A62562",
        "fontStyle": ""
      }
    },
    {
      "name": "Numeric overrides",
      "scope": [
        "constant.language",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#7D4B21",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.variable.property",
        "variable.other.property",
        "variable.object.property",
        "variable.other.member.c",
        "variable.other.object.property.java",
        "entity.name.variable.property.cs",
        "meta.object-literal.key.ts",
        "meta.object-literal.key.js",
        "meta.attribute.python"
      ],
      "settings": {
        "foreground": "#47587A",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#47587A",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#6941A1",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values and units",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#276349",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and macros",
      "scope": [
        "meta.decorator entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.function.macro"
      ],
      "settings": {
        "foreground": "#84435C",
        "fontStyle": ""
      }
    },
    {
      "name": "Shell commands and expansions",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.function.shell"
      ],
      "settings": {
        "foreground": "#245B91",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#A62562",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#414A5A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#414A5A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#276349",
        "fontStyle": ""
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#245B91",
        "fontStyle": ""
      }
    },
    {
      "name": "Inserted text",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3B6450",
        "fontStyle": ""
      }
    },
    {
      "name": "Deleted text",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#9A3B51",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed text",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#735628",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid tokens",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#9A3B51",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Language primitive and reference types",
      "scope": [
        "storage.type.string.go",
        "storage.type.numeric.go",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.rune.go",
        "storage.type.uintptr.go",
        "storage.type.built-in.primitive.c",
        "storage.type.primitive.cpp",
        "source.cs keyword.type",
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java",
        "storage.type.primitive.java"
      ],
      "settings": {
        "foreground": "#6941A1",
        "fontStyle": ""
      }
    },
    {
      "name": "Java declaration keywords",
      "scope": [
        "storage.type.class.java",
        "storage.type.interface.java",
        "storage.type.enum.java",
        "storage.type.annotation.java",
        "storage.type.local.java"
      ],
      "settings": {
        "foreground": "#A62562",
        "fontStyle": ""
      }
    },
    {
      "name": "Language annotations and attributes",
      "scope": [
        "meta.function.decorator.python support.type.python",
        "meta.function.decorator.python entity.name.function.python",
        "meta.decorator.python entity.name.function.python",
        "meta.declaration.annotation.java storage.type.annotation.java",
        "support.other.attribute.cpp entity.other.attribute",
        "meta.attribute.rust"
      ],
      "settings": {
        "foreground": "#84435C",
        "fontStyle": ""
      }
    },
    {
      "name": "Python call names",
      "scope": [
